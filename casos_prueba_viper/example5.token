DEF def
FLOAT float
ID media
LPAREN (
FLOAT float
ID a
COMMA ,
FLOAT float
ID b
RPAREN )
COLON :
LBRACE {
NEWLINE 

RETURN return
LPAREN (
ID a
PLUS +
ID b
RPAREN )
DIV /
NUMBER 2
NEWLINE 

RBRACE }
NEWLINE 

NEWLINE 


DEF def
FLOAT float
ID evaluarNota
LPAREN (
FLOAT float
ID nota1
COMMA ,
FLOAT float
ID nota2
RPAREN )
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID promedio
ASSIGN =
ID media
LPAREN (
ID nota1
COMMA ,
ID nota2
RPAREN )
NEWLINE 

IF if
ID promedio
GTE >=
NUMBER 5.0
COLON :
LBRACE {
NEWLINE 

RETURN return
ID promedio
NEWLINE 

RBRACE }
NEWLINE 

ELSE else
COLON :
LBRACE {
NEWLINE 

RETURN return
NUMBER 0.0
NEWLINE 

RBRACE }
NEWLINE 

NEWLINE 

RBRACE }
NEWLINE 

