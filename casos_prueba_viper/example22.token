TYPE type
ID String
COLON :
LBRACE {
NEWLINE 

CHAR char
LBRACKET [
NUMBER 64
RBRACKET ]
ID _
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID User
COLON :
LBRACE {
NEWLINE 

INT int
ID user_id
NEWLINE 

ID String
ID nickname
NEWLINE 

RBRACE }
NEWLINE 


INT int
ID global_id
ASSIGN =
NUMBER 0
NEWLINE 


DEF def
ID User
ID new_user
LPAREN (
ID String
ID nickname
RPAREN )
COLON :
LBRACE {
NEWLINE 

ID User
ID user
NEWLINE 

ID user
DOT .
ID user_id
ASSIGN =
ID global_id
NEWLINE 

ID global_id
ASSIGN =
ID global_id
PLUS +
NUMBER 1
NEWLINE 

ID user
DOT .
ID nickname
ASSIGN =
ID nickname
NEWLINE 

RETURN return
ID user
NEWLINE 

RBRACE }
NEWLINE 


ID String
ID nickname
NEWLINE 

ID nickname
DOT .
ID _
LBRACKET [
NUMBER 0
RBRACKET ]
ASSIGN =
CHAR_LITERAL V
NEWLINE 

ID nickname
DOT .
ID _
LBRACKET [
NUMBER 1
RBRACKET ]
ASSIGN =
CHAR_LITERAL i
NEWLINE 

ID nickname
DOT .
ID _
LBRACKET [
NUMBER 2
RBRACKET ]
ASSIGN =
CHAR_LITERAL p
NEWLINE 

ID nickname
DOT .
ID _
LBRACKET [
NUMBER 3
RBRACKET ]
ASSIGN =
CHAR_LITERAL e
NEWLINE 

ID nickname
DOT .
ID _
LBRACKET [
NUMBER 4
RBRACKET ]
ASSIGN =
CHAR_LITERAL r
NEWLINE 


ID new_user
LPAREN (
ID nickname
RPAREN )
