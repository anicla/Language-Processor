NEWLINE 


FLOAT float
ID f1
COMMA ,
ID f2
NEWLINE 

BOOL bool
ID b1
NEWLINE 

CHAR char
ID c
ASSIGN =
CHAR_LITERAL h
NEWLINE 


ID f1
ASSIGN =
NUMBER 5
MULT *
NUMBER 3
MINUS -
NUMBER 80
DIV /
NUMBER 10
NEWLINE 

ID f2
ASSIGN =
NUMBER 10
DIV /
NUMBER 5
MULT *
ID f1
NEWLINE 

ID b1
ASSIGN =
NUMBER 5
LT <
NUMBER 3
NEWLINE 

FLOAT float
ID num
NEWLINE 

BOOL bool
ID is_positive
NEWLINE 

IF if
ID num
GTE >=
NUMBER 0
COLON :
NEWLINE 

ID is_positive
ASSIGN =
TRUE true
NEWLINE 

ELSE else
COLON :
NEWLINE 

ID is_positive
ASSIGN =
FALSE false
NEWLINE 

FLOAT float
ID a
COMMA ,
ID b
COMMA ,
ID c
COMMA ,
ID _max
NEWLINE 

ID a
ASSIGN =
NUMBER 1
NEWLINE 

ID b
ASSIGN =
NUMBER 2
NEWLINE 

ID c
ASSIGN =
NUMBER 3
NEWLINE 

IF if
ID a
GTE >=
ID b
AND and
ID a
GTE >=
ID c
COLON :
NEWLINE 

ID _max
ASSIGN =
ID a
NEWLINE 

ELSE else
COLON :
NEWLINE 

IF if
ID b
GTE >=
ID a
AND and
ID b
GTE >=
ID c
COLON :
NEWLINE 

ID _max
ASSIGN =
ID b
NEWLINE 

ELSE else
COLON :
NEWLINE 

ID _max
ASSIGN =
ID c
