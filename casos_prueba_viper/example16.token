TYPE type
ID Circle
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID cx
COMMA ,
ID cy
COMMA ,
ID radius
NEWLINE 

CHAR char
ID color
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID Square
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID side
NEWLINE 

CHAR char
ID color
NEWLINE 

RBRACE }
NEWLINE 


NEWLINE 

ID Circle
ID c
NEWLINE 

ID c
DOT .
ID radius
ASSIGN =
NUMBER 10.2
NEWLINE 

ID c
DOT .
ID color
ASSIGN =
CHAR_LITERAL R
NEWLINE 

INT int
ID circle_area
ASSIGN =
NUMBER 3.14
MULT *
ID c
DOT .
ID radius
MULT *
ID c
DOT .
ID radius
NEWLINE 


ID Square
ID s
NEWLINE 

ID s
DOT .
ID side
ASSIGN =
NUMBER 10.0
NEWLINE 

ID s
DOT .
ID color
ASSIGN =
CHAR_LITERAL B
NEWLINE 

INT int
ID square_area
ASSIGN =
ID s
DOT .
ID side
MULT *
ID s
DOT .
ID side
NEWLINE 


BOOL bool
ID square_is_bigger
ASSIGN =
ID square_area
GT >
ID circle_area
