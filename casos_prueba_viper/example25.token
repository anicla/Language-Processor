NEWLINE 

DEF def
FLOAT float
ID square
LPAREN (
FLOAT float
ID f
RPAREN )
COLON :
LBRACE {
NEWLINE 

RETURN return
ID f
MULT *
ID f
NEWLINE 

RBRACE }
NEWLINE 


DEF def
INT int
ID square
LPAREN (
INT int
ID i
RPAREN )
COLON :
LBRACE {
NEWLINE 

RETURN return
ID i
MULT *
ID i
NEWLINE 

RBRACE }
NEWLINE 


DEF def
FLOAT float
ID power
LPAREN (
FLOAT float
ID f
COMMA ,
INT int
ID i
RPAREN )
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID r
ASSIGN =
NUMBER 1
NEWLINE 

INT int
ID s
ASSIGN =
NUMBER 1
NEWLINE 

WHILE while
ID s
LT <
ID i
COLON :
NEWLINE 

ID r
ASSIGN =
ID r
MULT *
ID f
NEWLINE 

ID s
ASSIGN =
ID s
PLUS +
NUMBER 1
NEWLINE 

NEWLINE 

RETURN return
ID r
NEWLINE 

RBRACE }
NEWLINE 


FLOAT float
ID decimal
NEWLINE 

INT int
ID integer
ASSIGN =
NUMBER 6
NEWLINE 

NUMBER 5
MULT *
NUMBER 3
NEWLINE 

ID decimal
ASSIGN =
NUMBER 3.7
NEWLINE 

ID decimal
ASSIGN =
NUMBER 3.7
PLUS +
ID square
LPAREN (
ID decimal
RPAREN )
NEWLINE 

ID decimal
ASSIGN =
ID power
LPAREN (
ID decimal
COMMA ,
ID integer
RPAREN )
NEWLINE 


IF if
ID integer
EQ ==
NUMBER 3
OR or
ID decimal
EQ ==
NUMBER 2
COLON :
LBRACE {
NEWLINE 

ID integer
ASSIGN =
ID integer
PLUS +
NUMBER 171
NEWLINE 

RBRACE }
NEWLINE 

ELSE else
COLON :
LBRACE {
NEWLINE 

ID decimal
ASSIGN =
ID square
LPAREN (
ID square
LPAREN (
ID integer
RPAREN )
RPAREN )
NEWLINE 

RBRACE }
