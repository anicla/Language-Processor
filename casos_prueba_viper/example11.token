TYPE type
ID Point
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID x
COMMA ,
ID y
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID Circle
COLON :
LBRACE {
NEWLINE 

ID Point
ID center
NEWLINE 

FLOAT float
ID radius
NEWLINE 

RBRACE }
NEWLINE 


ID Circle
LBRACKET [
NUMBER 2
RBRACKET ]
ID balls
NEWLINE 

ID balls
LBRACKET [
NUMBER 0
RBRACKET ]
DOT .
ID center
DOT .
ID x
ASSIGN =
NUMBER 5
NEWLINE 

ID balls
LBRACKET [
NUMBER 0
RBRACKET ]
DOT .
ID center
DOT .
ID y
ASSIGN =
NUMBER 255
NEWLINE 

ID balls
LBRACKET [
NUMBER 0
RBRACKET ]
DOT .
ID radius
ASSIGN =
NUMBER 1.74
NEWLINE 

ID balls
LBRACKET [
NUMBER 1
RBRACKET ]
DOT .
ID center
DOT .
ID x
ASSIGN =
NUMBER 1.0
NEWLINE 

ID balls
LBRACKET [
NUMBER 1
RBRACKET ]
DOT .
ID center
DOT .
ID y
ASSIGN =
MINUS -
NUMBER 31
NEWLINE 

ID balls
LBRACKET [
NUMBER 1
RBRACKET ]
DOT .
ID radius
ASSIGN =
NUMBER 3.2
NEWLINE 


INT int
ID i
ASSIGN =
NUMBER 0
NEWLINE 

WHILE while
ID i
LT <
ID balls
DOT .
ID len
COLON :
LBRACE {
NEWLINE 

ID balls
LBRACKET [
ID i
RBRACKET ]
DOT .
ID center
DOT .
ID x
ASSIGN =
ID balls
LBRACKET [
ID i
RBRACKET ]
DOT .
ID center
DOT .
ID x
PLUS +
NUMBER 1
NEWLINE 

ID balls
LBRACKET [
ID i
RBRACKET ]
DOT .
ID center
DOT .
ID y
ASSIGN =
ID balls
LBRACKET [
ID i
RBRACKET ]
DOT .
ID center
DOT .
ID y
PLUS +
NUMBER 2
NEWLINE 

ID i
ASSIGN =
ID i
PLUS +
NUMBER 1
NEWLINE 

RBRACE }
NEWLINE 



NEWLINE 

DEF def
BOOL bool
ID gte
LPAREN (
INT int
ID a
COMMA ,
INT int
ID b
RPAREN )
COLON :
LBRACE {
NEWLINE 

RETURN return
ID a
GT >
ID b
NEWLINE 

RBRACE }
NEWLINE 


NEWLINE 


CHAR char
ID result
NEWLINE 

IF if
ID gte
LPAREN (
ID balls
LBRACKET [
NUMBER 0
RBRACKET ]
DOT .
ID radius
COMMA ,
ID balls
LBRACKET [
NUMBER 1
RBRACKET ]
DOT .
ID radius
RPAREN )
COLON :
LBRACE {
NEWLINE 

ID result
ASSIGN =
CHAR_LITERAL Y
NEWLINE 

RBRACE }
NEWLINE 

ELSE else
COLON :
LBRACE {
NEWLINE 

ID result
ASSIGN =
CHAR_LITERAL N
NEWLINE 

RBRACE }
