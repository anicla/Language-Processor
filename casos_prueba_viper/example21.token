INT int
ID a
NEWLINE 

INT int
ID b
NEWLINE 


DEF def
INT int
ID mod
LPAREN (
INT int
ID a
COMMA ,
ID b
RPAREN )
COLON :
LBRACE {
NEWLINE 

WHILE while
ID a
GTE >=
ID b
COLON :
NEWLINE 

ID a
ASSIGN =
ID a
MINUS -
ID b
NEWLINE 

NEWLINE 


RETURN return
ID a
NEWLINE 

RBRACE }
NEWLINE 


DEF def
INT int
ID greatest_common_divisor
LPAREN (
INT int
ID a
COMMA ,
ID b
RPAREN )
COLON :
LBRACE {
NEWLINE 

INT int
ID temp
NEWLINE 

WHILE while
NOT not
ID b
EQ ==
NUMBER 0
COLON :
NEWLINE 

ID temp
ASSIGN =
ID b
NEWLINE 

ID b
ASSIGN =
ID mod
LPAREN (
ID a
COMMA ,
ID b
RPAREN )
NEWLINE 

ID a
ASSIGN =
ID temp
NEWLINE 


NEWLINE 

RETURN return
ID a
NEWLINE 

RBRACE }
NEWLINE 


INT int
ID result
ASSIGN =
ID greatest_common_divisor
LPAREN (
NUMBER 132
COMMA ,
NUMBER 255
RPAREN )
