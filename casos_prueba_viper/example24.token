NEWLINE 

TYPE type
ID Vector2D
COLON :
LBRACE {
NEWLINE 

FLOAT float
ID x1
COMMA ,
ID x2
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID Ball
COLON :
LBRACE {
NEWLINE 

ID Vector2D
ID center
NEWLINE 

FLOAT float
ID radius
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID Word
COLON :
LBRACE {
NEWLINE 

CHAR char
LBRACKET [
NUMBER 10
RBRACKET ]
ID s
NEWLINE 

RBRACE }
NEWLINE 


TYPE type
ID Human
COLON :
LBRACE {
NEWLINE 

ID Word
ID name
COMMA ,
ID last_name_1
COMMA ,
ID last_name_2
NEWLINE 

INT int
ID age
NEWLINE 

RBRACE }
NEWLINE 


ID Ball
ID ball
NEWLINE 

ID Human
ID student
NEWLINE 

ID ball
DOT .
ID center
DOT .
ID x1
ASSIGN =
NUMBER 0.0
NEWLINE 

ID ball
DOT .
ID center
DOT .
ID x2
ASSIGN =
NUMBER 0.0
NEWLINE 

ID ball
DOT .
ID radius
ASSIGN =
NUMBER 10.0
NEWLINE 


ID student
DOT .
ID name
DOT .
ID s
LBRACKET [
NUMBER 0
RBRACKET ]
ASSIGN =
CHAR_LITERAL S
NEWLINE 

ID student
DOT .
ID name
DOT .
ID s
LBRACKET [
NUMBER 1
RBRACKET ]
ASSIGN =
CHAR_LITERAL a
NEWLINE 

ID student
DOT .
ID name
DOT .
ID s
LBRACKET [
NUMBER 2
RBRACKET ]
ASSIGN =
CHAR_LITERAL u
NEWLINE 

ID student
DOT .
ID name
DOT .
ID s
LBRACKET [
NUMBER 3
RBRACKET ]
ASSIGN =
CHAR_LITERAL l
NEWLINE 


ID student
DOT .
ID last_name_1
DOT .
ID s
LBRACKET [
NUMBER 0
RBRACKET ]
ASSIGN =
CHAR_LITERAL P
NEWLINE 

ID student
DOT .
ID last_name_1
DOT .
ID s
LBRACKET [
NUMBER 1
RBRACKET ]
ASSIGN =
CHAR_LITERAL e
NEWLINE 

ID student
DOT .
ID last_name_1
DOT .
ID s
LBRACKET [
NUMBER 2
RBRACKET ]
ASSIGN =
CHAR_LITERAL r
NEWLINE 

ID student
DOT .
ID last_name_1
DOT .
ID s
LBRACKET [
NUMBER 3
RBRACKET ]
ASSIGN =
CHAR_LITERAL e
NEWLINE 

ID student
DOT .
ID last_name_1
DOT .
ID s
LBRACKET [
NUMBER 4
RBRACKET ]
ASSIGN =
CHAR_LITERAL z
NEWLINE 


ID student
DOT .
ID last_name_2
DOT .
ID s
LBRACKET [
NUMBER 0
RBRACKET ]
ASSIGN =
CHAR_LITERAL G
NEWLINE 

ID student
DOT .
ID last_name_2
DOT .
ID s
LBRACKET [
NUMBER 1
RBRACKET ]
ASSIGN =
CHAR_LITERAL o
NEWLINE 

ID student
DOT .
ID last_name_2
DOT .
ID s
LBRACKET [
NUMBER 2
RBRACKET ]
ASSIGN =
CHAR_LITERAL m
NEWLINE 

ID student
DOT .
ID last_name_2
DOT .
ID s
LBRACKET [
NUMBER 3
RBRACKET ]
ASSIGN =
CHAR_LITERAL e
NEWLINE 

ID student
DOT .
ID last_name_2
DOT .
ID s
LBRACKET [
NUMBER 4
RBRACKET ]
ASSIGN =
CHAR_LITERAL z
NEWLINE 


ID student
DOT .
ID age
ASSIGN =
NUMBER 19
NEWLINE 

BOOL bool
ID go
ASSIGN =
TRUE true
NEWLINE 

WHILE while
ID go
AND and
ID ball
DOT .
ID radius
GT >
NUMBER 0
COLON :
LBRACE {
NEWLINE 

IF if
ID ball
DOT .
ID center
DOT .
ID x1
LT <
NUMBER 0
AND and
ID ball
DOT .
ID center
DOT .
ID x2
LT <
NUMBER 0
COLON :
LBRACE {
NEWLINE 

ID go
ASSIGN =
FALSE false
NEWLINE 

RBRACE }
NEWLINE 

ELSE else
COLON :
LBRACE {
NEWLINE 

ID go
ASSIGN =
TRUE true
NEWLINE 

ID ball
DOT .
ID radius
ASSIGN =
ID ball
DOT .
ID radius
DIV /
NUMBER 2.0
NEWLINE 

ID ball
DOT .
ID center
DOT .
ID x1
ASSIGN =
ID ball
DOT .
ID center
DOT .
ID x1
MINUS -
NUMBER 1
NEWLINE 

ID ball
DOT .
ID center
DOT .
ID x2
ASSIGN =
ID ball
DOT .
ID center
DOT .
ID x2
MINUS -
NUMBER 1
NEWLINE 

RBRACE }
NEWLINE 

NEWLINE 

RBRACE }
